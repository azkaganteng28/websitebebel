<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Permintaan Maaf Sayang</title>
  <style>
    body {
      background-color: #ffe6f0;
      color: #ff3385;
      font-family: 'Comic Sans MS', cursive, sans-serif;
      text-align: center;
      padding: 50px 20px;
      overflow: hidden;
    }

    h1 {
      font-size: 2.5em;
    }

    p {
      font-size: 1.5em;
      margin-top: 20px;
    }

    .love {
      position: absolute;
      font-size: 2em;
      animation: floatLove 4s infinite ease-in-out;
    }

    @keyframes floatLove {
      0% {
        transform: translateY(0) scale(1);
        opacity: 1;
      }
      100% {
        transform: translateY(-200px) scale(1.5);
        opacity: 0;
      }
    }
  </style>
</head>
<body>
  <h1>Maafin aku yaa Sayang!</h1>
  <p>Aku sayang kamu...<br>I love you banget!</p>

  <!-- Love icons floating -->
  <script>
    function createHeart() {
      const heart = document.createElement("div");
      heart.className = "love";
      heart.style.left = Math.random() * 100 + "vw";
      heart.style.top = Math.random() * 100 + "vh";
      heart.innerText = "♥";
      document.body.appendChild(heart);

      setTimeout(() => {
        heart.remove();
      }, 4000);
    }

    setInterval(createHeart, 300);
  </script>
</body>
</html>
